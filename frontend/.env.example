# SkillCatalyst Frontend Environment Configuration
# ===============================================

# Local Development (FastAPI running locally on port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Production (Set in Vercel Project Settings -> Environment Variables)
# Replace with your actual Railway public domain:
# NEXT_PUBLIC_API_URL=https://skillcatalyst-backend.up.railway.app/api/v1

# YouTube Data API v3
NEXT_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key_here
