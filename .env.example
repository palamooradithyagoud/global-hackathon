# SkillCatalyst Environment Configuration Template
DATABASE_URL=sqlite:///./skillcatalyst.db
ENVIRONMENT=development

# AI Reasoning & Fit Engine
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Jooble Live Job Feed (India)
JOOBLE_API_KEY=your_jooble_api_key_here
