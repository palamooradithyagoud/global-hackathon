# YouTube Data API v3 (Playlist & Lectures)
YOUTUBE_API_KEY=your_youtube_api_key_here

# ChromaDB & Chroma Cloud Configuration
CHROMA_USE_CLOUD=false
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_id_here
CHROMA_DATABASE=your_chroma_database_name_here
CHROMA_COLLECTION_NAME=scholarships
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ASCEND / n8n Automation Webhook
ASCEND_WEBHOOK_URL=https://shivanallela36367677777.app.n8n.cloud/webhook/a08e294f-15d2-41e8-b4fa-591cea88a801
