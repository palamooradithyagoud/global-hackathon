# SkillCatalyst Backend Configuration

# Database Configuration
# For Supabase PostgreSQL, use the connection string from your Supabase Project Settings:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# When left empty or default, it falls back to local SQLite (sqlite:///./skillcatalyst.db) for zero-setup demo
DATABASE_URL=sqlite:///./skillcatalyst.db

# API Settings
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PROJECT_NAME=SkillCatalyst API

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","https://skillcatalyst.vercel.app"]

# ASCEND / n8n Automation Webhook (Welcome Email)
ASCEND_WEBHOOK_URL=https://shivanallela36367677777.app.n8n.cloud/webhook/a08e294f-15d2-41e8-b4fa-591cea88a801
ASCEND_WEBHOOK_KEY=
ASCEND_WEBHOOK_HEADER_NAME=X-Webhook-Key
ASCEND_WEB_URL=http://localhost:3000
N8N_WEBHOOK_ENABLED=true

# ASCEND / n8n Scholarship Eligibility Webhook
ASCEND_SCHOLARSHIP_WEBHOOK_URL=https://shivanallela36367677777.app.n8n.cloud/webhook/scholarship-check-api
N8N_SCHOLARSHIP_WEBHOOK_ENABLED=true

